# Copy this file to .env and fill in your own values.

# Persistent PostgreSQL database URL (Neon, Supabase, Vercel Postgres, AWS RDS, etc.)
# For Vercel production: Use Neon (neon.tech) or Supabase (supabase.com) free tier.
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Base URL this app is reachable at — used to build client-facing links.
# In production on Vercel: set to https://your-domain.vercel.app
APP_URL="https://your-domain.vercel.app"

# NextAuth — generate a secret with: npx auth secret  (or any random string)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The one admin login for this app. Don't put a plain password here —
# run `npm run make-admin -- you@example.com "your password"` and it will
# print the ADMIN_EMAIL / ADMIN_PASSWORD_HASH lines to paste in below
# (it already escapes the $ characters for you — see the note below).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""
# Note: a bcrypt hash is full of "$" characters (e.g. $2a$10$...). If you
# ever paste one in by hand instead of using make-admin, escape every "$" as
# "\$" — otherwise Next's .env loader treats "$2a" etc as a variable
# reference and silently strips it, breaking login.

# SMTP settings used to send invoice emails and automatic due-date reminders.
# Any SMTP provider works (Gmail app password, Zoho, SendGrid, Resend SMTP, etc).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="app-password-here"
SMTP_FROM="Your Business <you@example.com>"

# Turns the in-process daily reminder scheduler on/off (runs inside `next start`).
REMINDER_CRON_ENABLED="true"
# Hour of day (0-23, server local time) the daily reminder sweep runs at.
REMINDER_CRON_HOUR="9"

# Shared secret required to call POST /api/cron/reminders from an external
# scheduler (e.g. Windows Task Scheduler, a hosting provider's cron, GitHub
# Actions) instead of relying on the in-process scheduler above.
CRON_SECRET="replace-with-another-random-string"
